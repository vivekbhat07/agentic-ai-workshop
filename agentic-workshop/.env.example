# Leave every key empty to use the offline fakes (recommended for Sessions 1-3).

# Which LLM to use: fake | gemini | openai.
# If empty, the first key found below wins (Gemini, then OpenAI), else fake.
LLM_PROVIDER=

# Google Gemini — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
